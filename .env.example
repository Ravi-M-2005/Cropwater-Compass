# Cropwater Compass - Environment Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional Weather API keys (Open-Meteo works without key, optional OpenWeatherMap key)
OPENWEATHER_API_KEY=
USE_SIMULATED_WEATHER_FALLBACK=true

# Database storage
DB_PATH=backend/data/cropwater.db
MODELS_DIR=ml/saved_models
